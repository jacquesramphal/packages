{
  "name": "@jacquesramphal/stateline",
  "version": "0.2.0",
  "description": "Form fields whose border is their state, and backgrounds made of the same moves, by Jacques Ramphal. The outline follows the caret, goes jagged when the input is wrong, circles while it sends and flies apart when it is sent. Patterns turn those moves into loose, animated line backgrounds that react to the pointer. Each field enhances a real element, so the form still works without the script.",
  "license": "MIT",
  "author": {
    "name": "Jacques Ramphal",
    "url": "https://ramphal.design"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacquesramphal/packages.git",
    "directory": "packages/stateline"
  },
  "bugs": {
    "url": "https://github.com/jacquesramphal/packages/issues"
  },
  "homepage": "https://ramphal.design/doc/make-it-pop",
  "private": false,
  "main": "./stateline.js",
  "types": "./stateline.d.ts",
  "unpkg": "./stateline.js",
  "jsdelivr": "./stateline.js",
  "exports": {
    ".": {
      "types": "./stateline.d.ts",
      "default": "./stateline.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.mjs"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.mjs"
    },
    "./patterns": {
      "types": "./patterns.d.ts",
      "default": "./patterns.js"
    },
    "./package.json": "./package.json",
    "./options.json": "./options.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "stateline.js",
    "stateline.d.ts",
    "options.json",
    "vue.mjs",
    "vue.d.ts",
    "react.mjs",
    "react.d.ts",
    "patterns.js",
    "patterns.d.ts",
    "example.html",
    "README.md",
    "CITATION.cff",
    "LICENSE"
  ],
  "dependencies": {
    "@jacquesramphal/border-field": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stateline",
    "form",
    "input",
    "border",
    "outline",
    "checkbox",
    "email",
    "did-you-mean",
    "typo",
    "animation",
    "micro-interaction",
    "svg",
    "accessible",
    "progressive-enhancement",
    "vue",
    "react",
    "background",
    "pattern",
    "generative",
    "canvas"
  ]
}
